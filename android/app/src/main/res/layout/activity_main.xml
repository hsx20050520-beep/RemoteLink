<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RemoteLink"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="手机控制电脑 · 跨网直连 · 原画画质"
            android:textColor="#8A93A3"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="设备"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="还没有设备\n点下方「添加设备」粘贴电脑上显示的链接"
            android:textColor="#5A6472"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/addBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#3B82F6"
            android:text="＋ 添加设备"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="默认设置"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="画质"
            android:textColor="#8A93A3"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/qualityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/qOriginal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#3B82F6"
                android:text="原画"
                android:textColor="#EEF1F5" />

            <RadioButton
                android:id="@+id/qHd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#3B82F6"
                android:text="高清"
                android:textColor="#EEF1F5" />

            <RadioButton
                android:id="@+id/qSmooth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#3B82F6"
                android:text="流畅"
                android:textColor="#EEF1F5" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="帧率"
            android:textColor="#8A93A3"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/fpsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/f60"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#3B82F6"
                android:text="60"
                android:textColor="#EEF1F5" />

            <RadioButton
                android:id="@+id/f30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#3B82F6"
                android:text="30"
                android:textColor="#EEF1F5" />

            <RadioButton
                android:id="@+id/f15"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#3B82F6"
                android:text="15"
                android:textColor="#EEF1F5" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/landscapeCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:buttonTint="#3B82F6"
            android:text="控制页强制横屏"
            android:textColor="#EEF1F5" />

        <CheckBox
            android:id="@+id/autoConnectCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#3B82F6"
            android:text="启动后自动连接最近设备"
            android:textColor="#EEF1F5" />

    </LinearLayout>
</ScrollView>
